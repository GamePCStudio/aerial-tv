<resources>
    <!-- The launcher's name. Lite's own, kept out of the full app's shared copy (see the
         copyStrings filter in lite/build.gradle.kts, which drops the full app's app_name). -->
    <string name="app_name">SuperHome</string>

    <!-- SuperHome's Personalize row: the shape of an app's picture. -->
    <string name="sh_icon_type">App icon type</string>
    <string name="sh_shape_wide">Wide</string>
    <string name="sh_shape_square">Square</string>
    <!-- The note under the row, shown while it holds focus. -->
    <string name="sh_icon_type_hint">Wide draws Aerial\'s tile art from the app\'s TV banner, four to six a row. Square shows the app\'s own Android icon, five to eight a row.</string>

    <!-- SuperHome's preset folder for the apps on the system image. -->
    <string name="folder_system">System apps</string>

    <!-- SuperHome's last Personalize row: the preset list applied again, by hand. -->
    <string name="sh_preset_force">Force app regrouping and renaming</string>
    <string name="sh_preset_run">Run now</string>
    <string name="sh_preset_force_hint">Files and names every app on this TV by the list — the TV\'s own file first, then the cloud copy, then the built-in one; a name typed on the phone still wins. Tiles you move afterwards stay where you moved them.</string>
    <string name="sh_preset_running">Reading the list…</string>
    <string name="sh_preset_done">%1$d apps filed into preset folders, %2$d named from the list</string>
