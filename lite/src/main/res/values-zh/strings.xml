<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 桌面的名字（简体中文）。其余语言没有这一份，走 values/ 的英文。 -->
    <string name="app_name">超级影视桌面</string>

    <!-- 个性化里的磁贴形状一行。 -->
    <string name="sh_icon_type">App图标类型</string>
    <string name="sh_shape_wide">长方形</string>
    <string name="sh_shape_square">正方形</string>
    <string name="sh_icon_type_hint">长方形：用 Aerial 的磁贴美术，取 App 自带的电视横幅，每排 4–6 个。正方形：用 App 自己的安卓标准图标，每排 5–8 个。</string>

    <string name="folder_system">系统应用</string>

    <!-- 个性化最下方那一行：把手工名单再强制生效一次。 -->
    <string name="sh_preset_force">强制APP重分组和APP重命名</string>
    <string name="sh_preset_run">现在执行</string>
    <string name="sh_preset_force_hint">按名单（电视上的文件 > 云端 > APK 内置；手机上改过的名字仍然优先）给这台电视所有 App 重新分组、重命名一次。之后自己挪动的磁贴不会被挪回。</string>
    <string name="sh_preset_running">正在读名单…</string>
    <string name="sh_preset_done">已把 %1$d 个 App 放进预设文件夹，%2$d 个 App 用名单上的名字</string>

    <!-- 个性化里的「音量」：动的是电视自己的音乐音量。 -->
    <string name="sh_volume">音量</string>
    <string name="sh_volume_max">启动时自动最大化</string>
    <string name="sh_volume_lock">自动锁死最大音量</string>
    <string name="sh_volume_no">否</string>
    <string name="sh_volume_hint">电视自己的音乐音量，不是某个 App 的。选「启动时自动最大化」：桌面一起来就把它拧到最大。选「自动锁死最大音量」：桌面运行期间任何人往下调——遥控器的音量键、别的 App 的滑杆——都会立刻被顶回最大。音量本来就由音响或 HDMI-CEC 决定、机顶盒固定输出的机器上没有东西可拧，日志会说明。</string>

    <!-- 设置列表里 SuperHome 自己的一行，和「个性化」平级。 -->
    <string name="sh_reboot">重启设备</string>
    <string name="sh_reboot_again">要确认：几秒内再按一次「重启设备」</string>
    <string name="sh_reboot_going">正在请求这台电视重启…</string>
    <string name="sh_reboot_denied">这台电视不让桌面重启：需要系统授权或 root</string>

    <!-- 「启动时重要信息提示」：程序说明 §24。 -->
    <string name="sh_notice">启动时重要信息提示</string>
    <string name="sh_notice_on">开</string>
    <string name="sh_notice_off">关</string>
    <string name="sh_notice_hint">桌面启动时把 superaerialnotice.txt 的内容显示在屏幕正中。读的顺序和预设名单一样：这台电视自己的文件优先，其次是电视上写的地址（/sdcard/tv/superaerialnotice.url）、我们站点、最后是内置的一份。文字下方两个按钮：「确认」从十秒开始倒数，数完两秒后自动确认；「不再提醒」等于把这个开关关掉，以后启动不再弹出。开关关掉也不压住新提醒——内容换过以后，第一次启动仍会告知「有新的重要提醒」，看过一次就不再追问。</string>
    <string name="sh_notice_title">重要提醒</string>
    <string name="sh_notice_new">有新的重要提醒</string>
    <string name="sh_notice_new_hint">这条提醒这台电视还没有给你看过。</string>
    <string name="sh_notice_view">查看</string>
    <string name="sh_notice_later">稍后</string>
    <string name="sh_notice_confirm">确认</string>
    <string name="sh_notice_confirm_count">确认（%1$d）</string>
    <string name="sh_notice_never">不再提醒</string>
    <string name="sh_notice_page">%1$d / %2$d</string>
</resources>
